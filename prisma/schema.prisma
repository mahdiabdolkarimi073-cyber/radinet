generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model HomeSlide {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String
  subtitle String
  description String @default("")
  imageUrl String @map("image_url")
  primaryCta String @default("خدمات ما") @map("primary_cta")
  secondaryCta String @default("درباره ما") @map("secondary_cta")
  displayOrder Int @default(0) @map("display_order")
  isPublished Boolean @default(true) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("home_slides")
}

model HomeService {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  description String @default("")
  iconKey String @default("services") @map("icon_key")
  colorTheme String @default("blue") @map("color_theme")
  ctaLabel String @default("مشاهده خدمات") @map("cta_label")
  displayOrder Int @default(0) @map("display_order")
  isPublished Boolean @default(true) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("home_services")
}

model HomeStat {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label String
  value String
  iconKey String @default("activity") @map("icon_key")
  displayOrder Int @default(0) @map("display_order")
  isPublished Boolean @default(true) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("home_stats")
}

model HomeNews {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String
  dateLabel String @map("date_label")
  imageUrl String @map("image_url")
  displayOrder Int @default(0) @map("display_order")
  isPublished Boolean @default(true) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("home_news")
}

model SiteSetting {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingKey String @unique @map("setting_key")
  settingValue Json @default("{}") @map("setting_value")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("site_settings")
}

model AboutContent {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  title String
  body String @db.Text
  isActive Boolean @default(true) @map("is_active")
  displayOrder Int @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("about_content")
}

model AboutMedia {
  id String @id @default(uuid()) @db.Uuid
  kind String
  title String
  imageUrl String @map("image_url")
  displayOrder Int @default(0) @map("display_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([kind, displayOrder])
  @@map("about_media")
}

model Certificate {
  id String @id @default(uuid()) @db.Uuid
  title String
  imageUrl String @map("image_url")
  fileUrl String? @map("file_url")
  displayOrder Int @default(0) @map("display_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("certificates")
}

model ConsultationRequest {
  id String @id @default(uuid()) @db.Uuid
  name String
  phone String
  email String?
  message String? @db.Text
  status String @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@map("consultation_requests")
}

model ContactMessage {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String
  phone String
  subject String
  message String @db.Text
  status String @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@map("contact_messages")
}

model ContactPageContent {
  id String @id @default(uuid()) @db.Uuid
  heroTitle String @default("تماس با ما") @map("hero_title")
  heroSubtitle String @default("با ما در ارتباط باشید") @map("hero_subtitle")
  introTitle String @default("اطلاعات تماس") @map("intro_title")
  introBody String @default("") @map("intro_body")
  officeAddress String @default("") @map("office_address")
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  mapUrl String? @map("map_url")
  responseHours String @default("") @map("response_hours")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("contact_page_content")
}

model ContactPhoneNumber {
  id String @id @default(uuid()) @db.Uuid
  label String @default("پشتیبانی")
  phone String
  isActive Boolean @default(true) @map("is_active")
  displayOrder Int @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([isActive, displayOrder])
  @@map("contact_phone_numbers")
}

model ContactSupportEmail {
  id String @id @default(uuid()) @db.Uuid
  label String @default("ایمیل پشتیبانی")
  email String
  isActive Boolean @default(true) @map("is_active")
  displayOrder Int @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([isActive, displayOrder])
  @@map("contact_support_emails")
}

model ContactResponseHour {
  id String @id @default(uuid()) @db.Uuid
  dayLabel String @map("day_label")
  hours String
  isActive Boolean @default(true) @map("is_active")
  displayOrder Int @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([isActive, displayOrder])
  @@map("contact_response_hours")
}

model LegalDocument {
  id String @id @default(uuid()) @db.Uuid
  documentType String @map("document_type")
  title String
  content String @db.Text
  versionNumber Int @default(1) @map("version_number")
  effectiveDate DateTime @default(now()) @map("effective_date")
  isActive Boolean @default(true) @map("is_active")
  scheduledPublishDate DateTime? @map("scheduled_publish_date")
  lastUpdated DateTime @default(now()) @map("last_updated")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([documentType, isActive])
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id")
  documentType String @map("document_type")
  title String
  content String @db.Text
  versionNumber Int @map("version_number")
  effectiveDate DateTime @map("effective_date")
  archivedAt DateTime @default(now()) @map("archived_at")
  @@index([documentId])
  @@map("legal_document_versions")
}

model LegalChangeLog {
  id String @id @default(uuid()) @db.Uuid
  documentId String? @map("document_id")
  documentType String? @map("document_type")
  actor String @default("admin")
  action String
  summary String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  @@index([documentId, createdAt])
  @@map("legal_change_logs")
}

model LegalConsent {
  id String @id @default(uuid()) @db.Uuid
  userIdentifier String @map("user_identifier")
  documentType String @map("document_type")
  documentVersion Int @map("document_version")
  acceptedAt DateTime @default(now()) @map("accepted_at")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  @@index([userIdentifier, documentType])
  @@map("legal_consents")
}

model LegalViewLog {
  id String @id @default(uuid()) @db.Uuid
  viewerIdentifier String? @map("viewer_identifier")
  documentType String @map("document_type")
  viewedAt DateTime @default(now()) @map("viewed_at")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  @@index([documentType, viewedAt])
  @@map("legal_view_logs")
}
